# ── Үндсэн ───────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Сайтын бүтэн хаяг (https-тэй). QPay callback, Facebook-ийн OG зураг үүнийг ашиглана.
BASE_URL=https://www.example.mn
# Урт санамсаргүй тэмдэгт мөр. Үүсгэх: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Өгөгдлийн сан, нөөц хуулбар хадгалах хавтас
DATA_DIR=./data
# Хэдэн өдрийн нөөц хуулбар хадгалах
BACKUP_KEEP=14

# ── Анхны админ (зөвхөн анх асаахад, админ байхгүй үед үүсгэнэ) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── QPay ─────────────────────────────────────────────────
# mock    = жинхэнэ төлбөргүй, туршилтын горим (хөгжүүлэлтэд)
# sandbox = QPay-ийн тест орчин
# live    = жинхэнэ төлбөр
QPAY_MODE=mock
# sandbox: https://merchant-sandbox.qpay.mn/v2   live: https://merchant.qpay.mn/v2
QPAY_BASE_URL=https://merchant.qpay.mn/v2
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=

# ── SMS ──────────────────────────────────────────────────
# console = SMS илгээхгүй, зөвхөн лог руу бичнэ (хөгжүүлэлтэд)
# wesend  = WeSend (wesend.mn): зөвхөн SMS_API_KEY хэрэгтэй, доорх SMS_HTTP_* хэрэггүй
# http    = SMS gateway-н HTTP API (доорх тохиргоог docs/SMS_SETUP.md-ээс үзнэ үү)
SMS_PROVIDER=console
SMS_API_KEY=
# Бүртгэлтэй илгээгчийн нэр / дугаар
SMS_SENDER=
# GET эсвэл POST
SMS_HTTP_METHOD=GET
# {to} {text} {from} {key} орлуулагдана. Жишээ (үйлчилгээ үзүүлэгчийнхээ баримт бичгээр шалгана уу):
SMS_HTTP_URL=https://api.example-sms.mn/send?key={key}&from={from}&to={to}&text={text}
# POST үед биеийн загвар (JSON эсвэл form), хоосон бол илгээхгүй
SMS_HTTP_BODY=
SMS_HTTP_CONTENT_TYPE=application/json
# Нэмэлт толгой мэдээлэл JSON-оор, жишээ: {"Authorization":"Bearer {key}"}
SMS_HTTP_HEADERS=
# Хүлээн авагчийн дугаарын өмнө залгах угтвар (жишээ: 976). Ихэнх gateway-д хоосон.
SMS_PHONE_PREFIX=
# Хариуд энэ үг/текст байвал амжилттай гэж үзнэ (хоосон бол HTTP 2xx хангалттай)
SMS_SUCCESS_MATCH=
