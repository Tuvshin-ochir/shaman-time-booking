<%- include('_top', { pageTitle: `Захиалга ${booking.code}` }) %>
<% const active = status === 'confirmed' || status === 'pending'; %>

<p><a href="/admin/bookings">← Захиалгын жагсаалт</a></p>
<div class="a-head">
  <h1>
    <span class="mono"><%= booking.code %></span>
    <%- include('_badge', { b: booking }) %>
  </h1>
</div>

<div class="detail-grid">
  <section class="a-card">
    <h2>Мэдээлэл</h2>
    <dl class="a-dl">
      <dt>Өдөр, цаг</dt><dd><strong><%= formatDate(booking.date) %>, <%= fromMin(booking.start_min) %>–<%= fromMin(booking.end_min) %></strong></dd>
      <dt>Үйлчилгээ</dt><dd><%= booking.service_name %></dd>
      <dt>Нэр</dt><dd><%= booking.customer_name %></dd>
      <dt>Утас</dt><dd><a href="tel:<%= booking.phone %>"><%= formatPhone(booking.phone) %></a></dd>
      <% if (booking.note) { %><dt>Үйлчлүүлэгчийн тайлбар</dt><dd><%= booking.note %></dd><% } %>
      <dt>Үнэ</dt><dd><%= formatPrice(booking.price) %></dd>
      <% if (booking.amount_due) { %><dt>Онлайнаар төлөх</dt><dd><%= formatPrice(booking.amount_due) %></dd><% } %>
      <dt>Төлсөн</dt><dd><%= formatPrice(booking.paid_amount) %><% if (booking.paid_at) { %> <small class="muted">(<%= formatTs(booking.paid_at) %>)</small><% } %></dd>
      <dt>Эх сурвалж</dt><dd><%= booking.source === 'admin' ? 'Админ гараар' : 'Вэбсайт' %></dd>
      <dt>Үүссэн</dt><dd><%= formatTs(booking.created_at) %></dd>
      <% if (status === 'pending') { %><dt>Цаг барих хугацаа</dt><dd><%= formatTs(booking.hold_expires_at) %> хүртэл</dd><% } %>
      <% if (booking.reminder_sent_at) { %><dt>Сануулга</dt><dd><%= formatTs(booking.reminder_sent_at) %> илгээсэн</dd><% } %>
      <% if (booking.cancel_reason) { %><dt>Цуцалсан шалтгаан</dt><dd><%= booking.cancel_reason %></dd><% } %>
    </dl>
    <p class="muted small">Үйлчлүүлэгчийн хуудас: <a href="/booking/<%= booking.token %>" target="_blank" rel="noopener">/booking/…</a></p>
  </section>

  <div class="detail-actions">
    <% if (booking.refund_status === 'pending') { %>
    <section class="a-card a-card-alert">
      <h2>Буцаалт хийх шаардлагатай</h2>
      <p class="small">Төлсөн дүн: <strong><%= formatPrice(booking.paid_amount) %></strong>. QPay merchant эсвэл банкаар буцаалт хийсний дараа доорх товчийг дарна уу.</p>
      <form method="post" action="/admin/bookings/<%= booking.id %>/refunded" data-confirm="Буцаалт хийгдсэн гэж тэмдэглэх үү?">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="a-btn a-btn-primary" type="submit">Буцаалт хийгдсэн</button>
      </form>
    </section>
    <% } %>

    <% if (active) { %>
    <section class="a-card">
      <h2>Цаг шилжүүлэх</h2>
      <form method="post" action="/admin/bookings/<%= booking.id %>/reschedule" class="a-form" data-slot-picker data-booking="<%= booking.id %>">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="a-row">
          <label>Өдөр <input type="date" name="date" value="<%= booking.date %>" data-slot-date required></label>
          <label>Цаг <input type="time" name="time" value="<%= fromMin(booking.start_min) %>" data-slot-time required step="300"></label>
        </div>
        <div class="slot-list" data-slot-list></div>
        <label class="a-check"><input type="checkbox" name="force"> Давхцлыг үл тоох</label>
        <label class="a-check"><input type="checkbox" name="notify" checked> Үйлчлүүлэгчид SMS илгээх</label>
        <button class="a-btn a-btn-primary" type="submit">Шилжүүлэх</button>
      </form>
    </section>

    <section class="a-card">
      <h2>Цуцлах</h2>
      <form method="post" action="/admin/bookings/<%= booking.id %>/cancel" class="a-form" data-confirm="Энэ захиалгыг цуцлах уу?">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label>Шалтгаан <input name="reason" maxlength="300" placeholder="Жишээ: Үйлчлүүлэгч хүсэлт гаргасан"></label>
        <% if (booking.paid_amount > 0) { %>
          <label class="a-check"><input type="checkbox" name="refund" checked> Төлбөр буцаах шаардлагатай гэж тэмдэглэх</label>
        <% } %>
        <label class="a-check"><input type="checkbox" name="notify" checked> Үйлчлүүлэгчид SMS илгээх</label>
        <button class="a-btn a-btn-danger" type="submit">Захиалга цуцлах</button>
      </form>
    </section>
    <% } %>

    <section class="a-card">
      <h2>Гараар төлбөр бүртгэх</h2>
      <form method="post" action="/admin/bookings/<%= booking.id %>/payment" class="a-form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="a-row">
          <label>Дүн (₮) <input name="amount" inputmode="numeric" required placeholder="<%= Math.max(0, booking.price - booking.paid_amount) %>"></label>
          <label>Тайлбар <input name="note" maxlength="200" placeholder="Бэлэн / шилжүүлэг"></label>
        </div>
        <button class="a-btn" type="submit">Бүртгэх</button>
      </form>
    </section>

    <section class="a-card">
      <h2>Дотоод тэмдэглэл</h2>
      <form method="post" action="/admin/bookings/<%= booking.id %>/note" class="a-form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <textarea name="admin_note" rows="3" maxlength="1000" placeholder="Зөвхөн админд харагдана"><%= booking.admin_note || '' %></textarea>
        <button class="a-btn" type="submit">Хадгалах</button>
      </form>
    </section>

    <section class="a-card">
      <h2>SMS дахин илгээх</h2>
      <form method="post" action="/admin/bookings/<%= booking.id %>/sms" class="a-form a-inline">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <select name="kind">
          <option value="confirm">Баталгаажуулалт (үйлчлүүлэгч + бөө)</option>
          <option value="reminder">Сануулга</option>
          <option value="reschedule">Цаг өөрчлөгдсөн</option>
          <option value="cancel">Цуцлагдсан</option>
        </select>
        <button class="a-btn" type="submit">Илгээх</button>
      </form>
    </section>
  </div>
</div>

<section class="a-section">
  <h2>Төлбөр</h2>
  <% if (payments.length) { %>
  <div class="a-table-wrap">
    <table class="a-table">
      <thead><tr><th>Огноо</th><th>Төрөл</th><th>Дүн</th><th>Төлөв</th><th>Нэхэмжлэх / гүйлгээ</th></tr></thead>
      <tbody>
      <% payments.forEach((p) => { %>
        <tr>
          <td><%= formatTs(p.created_at) %></td>
          <td><%= p.provider %></td>
          <td><%= formatPrice(p.amount) %></td>
          <td><span class="badge badge-pay-<%= p.status %>"><%= p.status %></span><% if (p.paid_at) { %> <small><%= formatTs(p.paid_at) %></small><% } %></td>
          <td class="mono small"><%= p.invoice_id || '' %><% if (p.provider_payment_id) { %><br><%= p.provider_payment_id %><% } %><% if (p.note) { %><br><%= p.note %><% } %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %><p class="a-empty">Төлбөр алга.</p><% } %>
</section>

<section class="a-section">
  <h2>SMS</h2>
  <% if (smsLog.length) { %>
  <div class="a-table-wrap">
    <table class="a-table">
      <thead><tr><th>Огноо</th><th>Хэнд</th><th>Төрөл</th><th>Төлөв</th><th>Текст</th></tr></thead>
      <tbody>
      <% smsLog.forEach((s) => { %>
        <tr>
          <td><%= formatTs(s.created_at) %></td>
          <td><%= formatPhone(s.to_phone) %></td>
          <td><%= s.kind %></td>
          <td><span class="badge badge-sms-<%= s.status %>"><%= s.status === 'sent' ? 'илгээсэн' : 'алдаа' %></span></td>
          <td class="small"><%= s.body %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %><p class="a-empty">SMS илгээгээгүй.</p><% } %>
</section>

<section class="a-section">
  <h2>Түүх</h2>
  <ol class="timeline">
    <% events.forEach((e) => { %>
      <li><time><%= formatTs(e.created_at) %></time> <strong><%= eventLabel(e.type) %></strong><% if (e.detail) { %> — <%= e.detail %><% } %> <small class="muted">(<%= e.actor %>)</small></li>
    <% }) %>
  </ol>
</section>

<%- include('_bottom') %>
