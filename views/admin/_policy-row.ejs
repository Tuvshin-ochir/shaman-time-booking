<% const textField = kind === 'highlight' ? 'text' : 'body'; %>
<div class="repeat-item is-<%= kind %>" data-repeat-item>
  <div class="repeat-fields">
    <% if (kind === 'highlight') { %>
      <label class="repeat-tone">
        <span>Өнгө</span>
        <select name="highlight:<%= id %>:tone">
          <% policyTones.forEach(([value, label]) => { %>
            <option value="<%= value %>"<%= item.tone === value ? ' selected' : '' %>><%= label %></option>
          <% }) %>
        </select>
      </label>
    <% } %>
    <label><span>Гарчиг</span><input name="<%= kind %>:<%= id %>:title" value="<%= item.title_mn || '' %>" maxlength="120"></label>
    <label class="is-wide">
      <span><%= kind === 'highlight' ? 'Тайлбар' : 'Текст' %></span>
      <textarea name="<%= kind %>:<%= id %>:<%= textField %>" rows="<%= kind === 'highlight' ? 2 : 4 %>"><%= item[`${textField}_mn`] || '' %></textarea>
    </label>
  </div>
  <div class="repeat-tools">
    <button type="button" class="a-btn a-btn-sm" data-repeat-up aria-label="Дээш шилжүүлэх">↑</button>
    <button type="button" class="a-btn a-btn-sm" data-repeat-down aria-label="Доош шилжүүлэх">↓</button>
    <button type="button" class="a-btn a-btn-sm a-btn-danger-ghost" data-repeat-remove>Устгах</button>
  </div>
</div>
