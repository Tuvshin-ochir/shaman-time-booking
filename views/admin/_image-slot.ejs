<div class="img-slot" data-image-slot>
  <div class="img-preview<%= slot === 'og' ? ' is-wide' : '' %>">
    <img src="<%= img.small || img.src %>" alt="" loading="lazy">
  </div>
  <div class="img-meta">
    <p class="img-title">
      <strong><%= cfg.label %></strong>
      <% if (custom) { %><span class="badge badge-confirmed">Өөрийн зураг</span><% } else { %><span class="badge badge-muted">Анхны зураг</span><% } %>
    </p>
    <% if (cfg.hint) { %><p class="small muted"><%= cfg.hint %></p><% } %>
    <p class="small muted">Одоогийн хэмжээ: <%= img.width %>×<%= img.height %></p>
    <div class="img-actions">
      <button type="button" class="a-btn a-btn-sm a-btn-primary" data-pick>Зураг солих</button>
      <input type="file" accept="image/*" hidden data-upload data-slot="<%= slot %>" data-large="<%= cfg.large %>" data-small="<%= cfg.small || '' %>" data-crop="<%= cfg.crop || '' %>">
      <% if (custom) { %><button type="button" class="a-btn a-btn-sm" data-image-reset="<%= slot %>">Анхны зураг руу буцаах</button><% } %>
    </div>
  </div>
</div>
