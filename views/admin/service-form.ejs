<%- include('_top', { pageTitle: service ? service.name : 'Шинэ үйлчилгээ' }) %>

<p><a href="/admin/services">← Үйлчилгээ</a></p>
<h1><%= service ? 'Үйлчилгээ засах' : 'Шинэ үйлчилгээ' %></h1>

<% if (errors.length) { %>
<div class="a-alert a-alert-err" role="alert"><ul><% errors.forEach((e) => { %><li><%= e %></li><% }) %></ul></div>
<% } %>

<form method="post" class="a-card a-form narrow">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Нэр (монгол) <input name="name" value="<%= form.name || '' %>" required maxlength="100"></label>
  <label>Тайлбар (монгол) <textarea name="description" rows="3" maxlength="1000"><%= form.description || '' %></textarea></label>
  <div class="a-row">
    <label>Үнэ (₮) <input name="price" inputmode="numeric" value="<%= form.price ?? '' %>" required></label>
    <label>Онлайн урьдчилгаа (₮)
      <input name="deposit" inputmode="numeric" value="<%= form.deposit ?? '' %>" placeholder="Хоосон = бүтэн үнэ">
    </label>
  </div>
  <p class="muted small">Урьдчилгаа хоосон бол QPay-ээр бүтэн үнийг төлнө. 0 бол онлайн төлбөргүйгээр шууд баталгаажна.</p>
  <div class="a-row">
    <label>Үргэлжлэх хугацаа (минут) <input type="number" name="duration_min" min="5" max="600" value="<%= form.duration_min || 30 %>" required></label>
    <label>Эрэмбэ <input type="number" name="sort" value="<%= form.sort ?? 0 %>"></label>
  </div>
  <label class="a-check"><input type="checkbox" name="active"<%= form.active ? ' checked' : '' %>> Идэвхтэй (сайтад харагдана)</label>
  <button class="a-btn a-btn-primary" type="submit">Хадгалах</button>
</form>

<% if (service) { %>
<section class="a-card narrow danger-zone">
  <h2>Үйлчилгээг устгах</h2>
  <p class="small muted">Сайтаас бүрмөсөн хасагдана. Өмнөх болон ирээдүйн захиалгууд хэвээр үлдэнэ.<% if (locals.upcoming) { %> Одоогоор <strong><%= upcoming %></strong> ирээдүйн захиалгатай.<% } %></p>
  <%- include('_service-delete', { s: service, upcomingCount: locals.upcoming || 0, label: 'Үйлчилгээг устгах' }) %>
</section>
<% } %>

<%- include('_bottom') %>
