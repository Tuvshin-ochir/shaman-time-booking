<%- include('_top', { pageTitle: 'Нэвтрэх' }) %>
<div class="a-login">
  <div class="a-card">
    <div class="a-login-brand"><%- include('../partials/logo') %><strong><%= business.name %></strong></div>
    <h1>Админ нэвтрэх</h1>
    <% if (error) { %><div class="a-alert a-alert-err" role="alert"><%= error %></div><% } %>
    <form method="post" class="a-form">
      <label>Нэвтрэх нэр
        <input name="username" autocomplete="username" required value="<%= username %>" autofocus>
      </label>
      <label>Нууц үг
        <input name="password" type="password" autocomplete="current-password" required>
      </label>
      <button class="a-btn a-btn-primary a-btn-block" type="submit">Нэвтрэх</button>
    </form>
    <a class="a-btn a-btn-block guide-link" href="/admin/guide">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5a2 2 0 012-2h5v17H6a2 2 0 00-2 2zM20 5a2 2 0 00-2-2h-5v17h5a2 2 0 012 2z"/></svg>
      Сайт ашиглах заавар
    </a>
  </div>
</div>
<%- include('_bottom') %>
