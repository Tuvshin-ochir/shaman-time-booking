<%- include('_top', { pageTitle: 'Самбар' }) %>

<div class="a-head">
  <h1>Өнөөдөр · <%= formatDate(today) %></h1>
  <div class="a-head-actions">
    <a class="a-btn a-btn-primary" href="/admin/bookings/new">+ Захиалга нэмэх</a>
  </div>
</div>

<% if (warnings.length) { %>
<div class="a-alert a-alert-warn">
  <ul><% warnings.forEach((w) => { %><li><%= w %></li><% }) %></ul>
</div>
<% } %>

<div class="stats">
  <a class="stat" href="/admin/bookings?view=today&status=confirmed"><span>Өнөөдрийн захиалга</span><strong><%= stats.today %></strong></a>
  <a class="stat" href="/admin/bookings?view=upcoming&status=confirmed"><span>Ирэх 7 хоногт</span><strong><%= stats.week %></strong></a>
  <a class="stat" href="/admin/bookings?view=all&status=pending"><span>Төлбөр хүлээж буй</span><strong><%= stats.pending %></strong></a>
  <a class="stat<%= stats.refunds ? ' stat-alert' : '' %>" href="/admin/bookings?view=all&status=refund"><span>Буцаалт хийх</span><strong><%= stats.refunds %></strong></a>
  <a class="stat" href="/admin/payments?status=paid"><span>Энэ сарын орлого</span><strong><%= formatPrice(stats.revenue) %></strong></a>
  <a class="stat<%= stats.smsFailed ? ' stat-alert' : '' %>" href="/admin/sms"><span>SMS алдаа (7 хоног)</span><strong><%= stats.smsFailed %></strong></a>
</div>

<section class="a-section">
  <div class="a-section-head">
    <h2>Өнөөдрийн хуваарь</h2>
    <a href="/admin/bookings?view=today&status=all">Бүгдийг харах →</a>
  </div>
  <% if (todays.length) { %>
    <%- include('_rows', { rows: todays, showDate: false }) %>
  <% } else { %>
    <p class="a-empty">Өнөөдөр захиалга алга.</p>
  <% } %>
</section>

<section class="a-section">
  <div class="a-section-head">
    <h2>Удахгүй болох</h2>
    <a href="/admin/bookings?view=upcoming&status=confirmed">Бүгд →</a>
  </div>
  <% if (upcoming.length) { %>
    <%- include('_rows', { rows: upcoming }) %>
  <% } else { %>
    <p class="a-empty">Ирээдүйн захиалга алга.</p>
  <% } %>
</section>

<%- include('_bottom') %>
