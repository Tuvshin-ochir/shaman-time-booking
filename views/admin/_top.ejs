<%
  const icons = {
    dashboard: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
    bookings: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4M8.5 15l2.5 2.5 4.5-4.5"/>',
    schedule: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
    landing: '<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M21 16l-5-5-9 9"/>',
    services: '<path d="M3 12V4a1 1 0 011-1h8l9 9-9 9z"/><circle cx="8" cy="8" r="1.5"/>',
    payments: '<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20M6 15h4"/>',
    sms: '<path d="M5 5h14a1 1 0 011 1v10a1 1 0 01-1 1H10l-5 4V6a1 1 0 011-1z"/>',
    settings: '<path d="M4 7h9M17 7h3M4 17h3M11 17h9"/><circle cx="15" cy="7" r="2"/><circle cx="9" cy="17" r="2"/>',
    external: '<path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 01-1 1H5a1 1 0 01-1-1V7a1 1 0 011-1h5"/>',
    logout: '<path d="M15 4h4a1 1 0 011 1v14a1 1 0 01-1 1h-4M10 16l-4-4 4-4M6 12h10"/>',
    menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  };
  const icon = (name) => `<svg class="a-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[name]}</svg>`;
  const groups = [
    ['Ажил', [['dashboard', '/admin', 'Самбар'], ['bookings', '/admin/bookings', 'Захиалга'], ['schedule', '/admin/schedule', 'Хуваарь']]],
    ['Сайт', [['landing', '/admin/landing', 'Нүүр хуудас'], ['services', '/admin/services', 'Үйлчилгээ ба үнэ']]],
    ['Систем', [['payments', '/admin/payments', 'Төлбөр'], ['sms', '/admin/sms', 'SMS'], ['settings', '/admin/settings', 'Тохиргоо']]],
  ];
  const badges = locals.navBadges || {};
%><!doctype html>
<html lang="mn">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title><%= locals.pageTitle ? `${pageTitle} · ` : '' %>Админ · <%= business.name %></title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="<%= asset('/assets/css/admin.css') %>">
</head>
<body class="<%= locals.admin ? 'a-app' : 'a-guest' %>">
<% if (locals.admin) { %>
<aside class="a-sidebar" id="a-sidebar" aria-label="Админ цэс">
  <a class="a-brand" href="/admin"><%- include('../partials/logo') %><span><%= business.name %></span></a>
  <nav class="a-side-nav">
    <% groups.forEach(([title, items]) => { %>
      <p class="a-nav-group"><%= title %></p>
      <% items.forEach(([key, href, label]) => { %>
        <a href="<%= href %>"<% if (locals.section === key) { %> aria-current="page"<% } %>>
          <%- icon(key) %><span><%= label %></span>
          <% if (badges[key]) { %><span class="a-badge" title="Анхаарах зүйл"><%= badges[key] %></span><% } %>
        </a>
      <% }) %>
    <% }) %>
  </nav>
  <div class="a-side-foot">
    <a href="/" target="_blank" rel="noopener"><%- icon('external') %><span>Сайт үзэх</span></a>
    <form method="post" action="/admin/logout">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button type="submit"><%- icon('logout') %><span>Гарах <small>(<%= admin.username %>)</small></span></button>
    </form>
  </div>
</aside>
<div class="a-backdrop" data-nav-close hidden></div>
<div class="a-page">
  <header class="a-topbar">
    <button type="button" class="a-menu-btn" data-nav-toggle aria-controls="a-sidebar" aria-expanded="false" aria-label="Цэс нээх"><%- icon('menu') %></button>
    <a class="a-brand a-brand-top" href="/admin"><%- include('../partials/logo') %><span><%= business.name %></span></a>
  </header>
<% } %>
<main class="a-main">
<% if (flash) { %><div class="a-alert a-alert-ok" role="status"><%= flash %></div><% } %>
<% if (flashError) { %><div class="a-alert a-alert-err" role="alert"><%= flashError %></div><% } %>
