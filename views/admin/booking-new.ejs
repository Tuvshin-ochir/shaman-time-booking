<%- include('_top', { pageTitle: 'Захиалга нэмэх' }) %>

<p><a href="/admin/bookings">← Захиалгын жагсаалт</a></p>
<h1>Гараар захиалга нэмэх</h1>
<p class="muted">Утсаар болон биечлэн ирсэн захиалгыг энд бүртгэнэ. Ажлын цагаас гадуур цаг ч сонгож болно.</p>

<% if (error) { %><div class="a-alert a-alert-err" role="alert"><%= error %></div><% } %>

<form method="post" action="/admin/bookings/new" class="a-card a-form narrow" data-slot-picker data-service-select="service_id">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Үйлчилгээ
    <select name="service_id" id="service_id" required>
      <% services.forEach((s) => { %>
        <option value="<%= s.id %>"<%= String(form.service_id) === String(s.id) ? ' selected' : '' %>><%= s.name %> (<%= s.duration_min %> мин, <%= formatPrice(s.price) %>)<%= s.active ? '' : ' — идэвхгүй' %></option>
      <% }) %>
    </select>
  </label>
  <div class="a-row">
    <label>Өдөр <input type="date" name="date" value="<%= form.date || '' %>" data-slot-date required></label>
    <label>Цаг <input type="time" name="time" value="<%= form.time || '' %>" data-slot-time required step="300"></label>
  </div>
  <div class="slot-list" data-slot-list></div>
  <div class="a-row">
    <label>Нэр <input name="name" value="<%= form.name || '' %>" required maxlength="80"></label>
    <label>Утас <input name="phone" type="tel" inputmode="numeric" value="<%= form.phone || '' %>" required maxlength="16" placeholder="99112233"></label>
  </div>
  <label>Тайлбар <input name="note" value="<%= form.note || '' %>" maxlength="500"></label>
  <label>Урьдчилж төлсөн дүн (₮, заавал биш) <input name="paid_amount" inputmode="numeric" value="<%= form.paid_amount || '' %>" placeholder="0"></label>
  <label class="a-check"><input type="checkbox" name="force"<%= form.force ? ' checked' : '' %>> Давхцлыг үл тоох (тухайн цагт өөр захиалга байсан ч нэмэх)</label>
  <label class="a-check"><input type="checkbox" name="notify"<%= form.notify ? ' checked' : '' %>> Үйлчлүүлэгч, бөө хоёуланд SMS илгээх</label>
  <button class="a-btn a-btn-primary" type="submit">Захиалга нэмэх</button>
</form>

<%- include('_bottom') %>
