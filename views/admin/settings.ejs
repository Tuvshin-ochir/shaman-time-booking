<%- include('_top', { pageTitle: 'Тохиргоо' }) %>

<h1>Тохиргоо</h1>
<nav class="quick-filters">
  <a href="#business">Байгууллага</a>
  <a href="#content">Сайтын текст</a>
  <a href="#sms">SMS</a>
  <a href="#password">Нууц үг</a>
  <a href="#system">Систем, нөөц</a>
</nav>

<% if (errors.length) { %>
<div class="a-alert a-alert-err" role="alert"><ul><% errors.forEach((e) => { %><li><%= e %></li><% }) %></ul></div>
<% } %>

<form method="post" action="/admin/settings/business" class="a-card a-form" id="business">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2>Байгууллагын мэдээлэл</h2>
  <label>Нэр <input name="name" value="<%= business.name %>" required maxlength="100"></label>
  <label>Уриа / товч тайлбар <input name="tagline" value="<%= business.tagline %>" maxlength="200"></label>
  <p class="muted small">Уриа нь Facebook-д линк хуваалцахад гарах тайлбар болно.</p>
  <div class="a-row">
    <label>Холбоо барих утас <input name="phone" value="<%= business.phone %>" maxlength="40"></label>
    <label>И-мэйл <input name="email" type="email" value="<%= business.email %>" maxlength="100"></label>
  </div>
  <label>Хаяг <input name="address" value="<%= business.address %>" maxlength="300"></label>
  <div class="a-row">
    <label>Газрын зургийн холбоос (Google Maps г.м) <input name="map_url" type="url" value="<%= business.map_url %>" placeholder="https://maps.app.goo.gl/..."></label>
    <label>Facebook хуудас <input name="facebook_url" type="url" value="<%= business.facebook_url %>" placeholder="https://facebook.com/..."></label>
  </div>
  <button class="a-btn a-btn-primary" type="submit">Хадгалах</button>
</form>

<form method="post" action="/admin/settings/content" class="a-card a-form" id="content">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2>Сайтын текст</h2>
  <p class="muted small">Нүүр хуудасны бүх текст, зураг болон цуцлах нөхцөлийг <a href="/admin/landing">Нүүр хуудас</a> цэснээс засна. Догол мөр тусгаарлахдаа хоосон мөр үлдээнэ.</p>
  <label>Бидний тухай <textarea name="about_mn" rows="8"><%= content.about_mn %></textarea></label>
  <button class="a-btn a-btn-primary" type="submit">Хадгалах</button>
</form>

<form method="post" action="/admin/settings/sms" class="a-card a-form" id="sms">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2>SMS</h2>
  <label>Бөөгийн утас (шинэ захиалга бүрт SMS очно)
    <input name="staff_phones" value="<%= smsSettings.staff_phones %>" placeholder="99112233, 88112233">
    <small>Олон дугаар бол таслалаар тусгаарлана.</small>
  </label>
  <label class="a-check"><input type="checkbox" name="reminders"<%= smsSettings.reminders ? ' checked' : '' %>> Захиалгын цагаас 1 өдрийн өмнө сануулга илгээх</label>
  <label class="a-check"><input type="checkbox" name="transliterate"<%= smsSettings.transliterate ? ' checked' : '' %>> Кирилл үсгийг латинаар илгээх (SMS хямд, бүх утсанд зөв харагдана)</label>

  <h3>SMS загвар</h3>
  <p class="muted small">Орлуулагдах үгс: {business} {name} {phone} {date} {time} {service} {address} {contact} {code}</p>
  <% [['customer_confirm', 'Үйлчлүүлэгчид — баталгаажсан'], ['staff_new', 'Бөөд — шинэ захиалга'], ['reminder', 'Үйлчлүүлэгчид — сануулга'], ['reschedule', 'Үйлчлүүлэгчид — цаг шилжсэн'], ['cancel', 'Үйлчлүүлэгчид — цуцлагдсан']].forEach(([key, label]) => { %>
    <label><%= label %> <textarea name="tpl_<%= key %>" rows="2" maxlength="500"><%= smsSettings.templates[key] %></textarea></label>
  <% }) %>
  <button class="a-btn a-btn-primary" type="submit">Хадгалах</button>
</form>

<form method="post" action="/admin/settings/sms-test" class="a-card a-form a-inline">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label class="grow">Туршилтын SMS илгээх дугаар <input name="phone" type="tel" inputmode="numeric" placeholder="99112233" required></label>
  <button class="a-btn" type="submit">Туршилт илгээх</button>
</form>

<form method="post" action="/admin/settings/password" class="a-card a-form narrow" id="password">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2>Нууц үг солих</h2>
  <label>Одоогийн нууц үг <input type="password" name="current" autocomplete="current-password" required></label>
  <label>Шинэ нууц үг (10+ тэмдэгт) <input type="password" name="new_password" autocomplete="new-password" minlength="10" required></label>
  <label>Шинэ нууц үг давтах <input type="password" name="confirm" autocomplete="new-password" minlength="10" required></label>
  <button class="a-btn a-btn-primary" type="submit">Солих</button>
</form>

<section class="a-card" id="system">
  <h2>Систем, нөөц хуулбар</h2>
  <dl class="a-dl">
    <dt>Сайтын хаяг</dt><dd><%= env.baseUrl %></dd>
    <dt>QPay горим</dt><dd><%= env.qpayMode %></dd>
    <dt>SMS</dt><dd><%= env.smsProvider %><% if (env.smsSender) { %> · илгээгч: <%= env.smsSender %><% } %></dd>
    <dt>Өгөгдлийн хавтас</dt><dd class="mono small"><%= env.dataDir %></dd>
    <dt>Автомат нөөц</dt><dd>Өдөр бүр, сүүлийн <%= env.backupKeep %> хоногийнх хадгалагдана (data/backups)</dd>
  </dl>
  <p class="muted small">QPay, SMS-ийн нууц түлхүүрүүдийг серверийн .env файлд тохируулна (docs/QPAY_SETUP.md, docs/SMS_SETUP.md).</p>
  <a class="a-btn" href="/admin/backup">Өгөгдлийн сангийн хуулбар татах</a>
</section>

<%- include('_bottom') %>
