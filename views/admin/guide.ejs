<%- include('_top') %>

<div class="guide-page">
  <header class="guide-top">
    <a class="guide-brand" href="/"><%- include('../partials/logo') %><span><%= business.name %></span></a>
    <a class="a-btn" href="<%= loggedIn ? '/admin' : '/admin/login' %>">← <%= loggedIn ? 'Админ самбар' : 'Нэвтрэх' %></a>
  </header>

  <div class="guide-hero">
    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5a2 2 0 012-2h5v17H6a2 2 0 00-2 2zM20 5a2 2 0 00-2-2h-5v17h5a2 2 0 012 2z"/></svg>
    <div>
      <h1>Сайт ашиглах заавар</h1>
      <p>Цаг захиалга, хуваарь, үнэ, нүүр хуудас, SMS-ийг админ самбараас хэрхэн удирдах вэ.</p>
    </div>
  </div>

  <div class="guide-layout">
    <details class="guide-toc" open>
      <summary>Агуулга</summary>
      <ol>
        <% guide.toc.forEach((item) => { %><li><a href="#<%= item.id %>"><%= item.text %></a></li><% }) %>
      </ol>
    </details>
    <article class="guide-body">
      <%- guide.html %>
    </article>
  </div>
</div>

<%- include('_bottom') %>
