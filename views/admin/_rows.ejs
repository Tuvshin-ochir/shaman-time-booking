<div class="b-list">
  <% rows.forEach((b) => { %>
  <a class="b-row" href="/admin/bookings/<%= b.id %>">
    <span class="b-when">
      <strong><%= fromMin(b.start_min) %></strong>
      <% if (locals.showDate !== false) { %><small><%= formatDate(b.date) %></small><% } %>
    </span>
    <span class="b-who">
      <strong><%= b.customer_name %></strong>
      <small><%= formatPhone(b.phone) %> · <span class="mono"><%= b.code %></span></small>
    </span>
    <span class="b-what"><%= b.service_name %></span>
    <span class="b-status"><%- include('_badge', { b }) %></span>
    <span class="b-paid"><%= b.paid_amount ? formatPrice(b.paid_amount) : '—' %></span>
  </a>
  <% }) %>
</div>
