<%- include('_top', { pageTitle: 'SMS' }) %>

<h1>SMS түүх</h1>
<p class="muted">Сүүлийн 200 SMS. Алдаатай SMS-ийг «Дахин илгээх» товчоор илгээнэ.</p>

<% if (rows.length) { %>
<div class="a-table-wrap">
  <table class="a-table">
    <thead><tr><th>Огноо</th><th>Хэнд</th><th>Төрөл</th><th>Захиалга</th><th>Төлөв</th><th>Текст</th><th></th></tr></thead>
    <tbody>
    <% rows.forEach((s) => { %>
      <tr>
        <td><%= formatTs(s.created_at) %></td>
        <td><%= formatPhone(s.to_phone) %></td>
        <td><%= s.kind %></td>
        <td><% if (s.booking_id) { %><a class="mono" href="/admin/bookings/<%= s.booking_id %>"><%= s.code %></a><% } %></td>
        <td>
          <span class="badge badge-sms-<%= s.status %>"><%= s.status === 'sent' ? 'илгээсэн' : 'алдаа' %></span>
          <% if (s.status === 'failed' && s.provider_response) { %><br><small class="muted"><%= s.provider_response.slice(0, 120) %></small><% } %>
        </td>
        <td class="small"><%= s.body %></td>
        <td>
          <% if (s.status === 'failed') { %>
          <form method="post" action="/admin/sms/<%= s.id %>/resend">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="a-btn a-btn-sm" type="submit">Дахин илгээх</button>
          </form>
          <% } %>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<% } else { %><p class="a-empty">SMS илгээгээгүй байна.</p><% } %>

<%- include('_bottom') %>
