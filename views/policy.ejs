<%- include('partials/head') %>
<%- include('partials/header') %>
<%
  const telHref = 'tel:' + business.phone.replace(/[^\d+]/g, '');
  const icons = {
    good: '<path d="M6 12.5l4 4 8-9"/>',
    warn: '<circle cx="12" cy="12" r="8"/><path d="M12 8v4.5l3 1.5"/>',
    bad: '<path d="M7 7l10 10M17 7L7 17"/>',
  };
  const intro = policy.intro_mn;
%>

<section class="policy-hero">
  <div class="container narrow">
    <h1><%= title %></h1>
    <% if (intro) { %><div class="lead"><%- paragraphs(intro) %></div><% } %>
    <% if (policy.updated_at) { %>
      <p class="policy-meta">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
        <%= t('policy.updated') %>: <%= policy.updated_at.replace(/-/g, '.') %>
      </p>
    <% } %>
  </div>
</section>

<section class="section section-tight">
  <div class="container narrow">
    <% if (policy.highlights.length) { %>
      <h2 class="policy-label"><%= t('policy.in_short') %></h2>
      <div class="policy-cards">
        <% policy.highlights.forEach((h) => { %>
          <div class="policy-card tone-<%= h.tone %>">
            <span class="policy-card-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- icons[h.tone] || icons.good %></svg>
            </span>
            <div>
              <h3><%= h.title_mn %></h3>
              <% if (h.text_mn) { %><p><%= h.text_mn %></p><% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <% if (policy.sections.length) { %>
      <h2 class="policy-label"><%= t('policy.details') %></h2>
      <div class="policy-sections">
        <% policy.sections.forEach((s, i) => { %>
          <section class="policy-section">
            <h3><span class="policy-num"><%= i + 1 %></span><%= s.title_mn %></h3>
            <div class="prose"><%- paragraphs(s.body_mn) %></div>
          </section>
        <% }) %>
      </div>
    <% } %>

    <aside class="policy-contact">
      <div>
        <h2><%= t('policy.contact_title') %></h2>
        <p><%= t('policy.contact_text') %></p>
      </div>
      <a class="btn btn-white btn-lg" href="<%= telHref %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2"/></svg>
        <%= business.phone %>
      </a>
    </aside>
  </div>
</section>

<%- include('partials/footer') %>
