<% const desc = s.description; %>
<article class="service-card">
  <div class="service-card-body">
    <h3><%= s.name %></h3>
    <% if (desc) { %><p class="muted"><%= desc %></p><% } %>
    <p class="chips">
      <span class="chip">
        <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 7v5l3 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <%= t('services.duration', { n: s.duration_min }) %>
      </span>
      <% if (s.deposit !== null && s.deposit < s.price) { %>
        <span class="chip chip-accent"><%= t('services.deposit', { amount: formatPrice(s.deposit) }) %></span>
      <% } %>
    </p>
  </div>
  <div class="service-card-foot">
    <span class="price"><%= formatPrice(s.price) %></span>
    <a class="btn btn-primary btn-sm" href="/book?service=<%= s.id %>"><%= t('services.book') %></a>
  </div>
</article>
