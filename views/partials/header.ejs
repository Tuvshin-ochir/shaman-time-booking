<%
  const navItems = [
    ['/', 'nav.home'],
    ['/services', 'nav.services'],
    ['/about', 'nav.about'],
    ['/contact', 'nav.contact'],
  ];
%>
<header class="site-header">
  <div class="container header-row">
    <a class="brand" href="/">
      <%- include('logo') %>
      <span class="brand-name"><%= business.name %></span>
    </a>
    <nav class="nav-desktop" aria-label="<%= t('nav.menu') %>">
      <% navItems.forEach(([href, key]) => { %>
        <a href="<%= href %>"<% if (path === href) { %> aria-current="page"<% } %>><%= t(key) %></a>
      <% }) %>
    </nav>
    <div class="header-tools">
      <button type="button" class="theme-toggle" data-theme-toggle aria-label="<%= t('theme.toggle') %>" title="<%= t('theme.toggle') %>">
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 019.5 4a8 8 0 1010.5 10.5z"/></svg>
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </div>
    <a class="btn btn-primary btn-sm header-cta" href="/book"><%= t('cta.book') %></a>
    <details class="nav-mobile">
      <summary aria-label="<%= t('nav.menu') %>">
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </summary>
      <nav class="nav-mobile-panel" aria-label="<%= t('nav.menu') %>">
        <% navItems.forEach(([href, key]) => { %>
          <a href="<%= href %>"<% if (path === href) { %> aria-current="page"<% } %>><%= t(key) %></a>
        <% }) %>
        <a href="/policy"<% if (path === '/policy') { %> aria-current="page"<% } %>><%= t('nav.policy') %></a>
      </nav>
    </details>
  </div>
</header>
<main id="main">
