</main>
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-about">
      <a class="brand brand-footer" href="/">
        <%- include('logo') %>
        <span class="brand-name"><%= business.name %></span>
      </a>
      <p class="muted"><%= business.tagline %></p>
    </div>
    <div>
      <p class="footer-title"><%= t('contact.title') %></p>
      <ul class="footer-list">
        <li><a href="tel:<%= business.phone.replace(/[^\d+]/g, '') %>"><%= business.phone %></a></li>
        <% if (business.email) { %><li><a href="mailto:<%= business.email %>"><%= business.email %></a></li><% } %>
        <li class="muted"><%= business.address %></li>
        <% if (business.facebook_url) { %><li><a href="<%= business.facebook_url %>" rel="noopener" target="_blank"><%= t('contact.facebook') %></a></li><% } %>
      </ul>
    </div>
    <div>
      <ul class="footer-list">
        <li><a href="/services"><%= t('nav.services') %></a></li>
        <li><a href="/about"><%= t('nav.about') %></a></li>
        <li><a href="/policy"><%= t('nav.policy') %></a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© <%= year %> <%= business.name %></span>
    <span class="secure-note">
      <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 10V8a6 6 0 1112 0v2m-13 0h14v11H5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
      <%= t('footer.secure') %>
    </span>
  </div>
</footer>
<% if (showStickyCta) { %>
<div class="sticky-cta">
  <a class="btn btn-primary btn-block btn-lg" href="/book"><%= t('cta.book') %></a>
</div>
<% } %>
<script src="<%= asset('/assets/js/theme.js') %>" defer></script>
<% (locals.scripts || []).forEach((src) => { %>
<script src="<%= asset(src) %>" defer></script>
<% }) %>
</body>
</html>
