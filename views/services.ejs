<%- include('partials/head') %>
<%- include('partials/header') %>

<section class="section page-head">
  <div class="container">
    <h1><%= title %></h1>
    <p class="lead"><%= t('services.intro') %></p>
  </div>
</section>

<section class="section section-tight">
  <div class="container">
    <% if (services.length) { %>
      <div class="cards">
        <% services.forEach((s) => { %><%- include('partials/service-card', { s }) %><% }) %>
      </div>
    <% } else { %>
      <p class="muted"><%= t('services.empty') %></p>
    <% } %>
    <p class="muted small"><a href="/policy"><%= t('nav.policy') %></a></p>
  </div>
</section>

<%- include('partials/footer') %>
