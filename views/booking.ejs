<%- include('partials/head') %>
<%- include('partials/header') %>

<% const telHref = 'tel:' + business.phone.replace(/[^\d+]/g, ''); %>
<section class="section section-tight">
  <div class="container narrow">
    <div class="result-card status-<%= status %>">
      <div class="result-icon" aria-hidden="true"><%= status === 'confirmed' ? '✓' : status === 'pending' ? '…' : '!' %></div>
      <h1><%= title %></h1>
      <% if (status === 'confirmed') { %>
        <p class="muted"><%= t('booking.sms_sent', { phone: formatPhone(booking.phone) }) %></p>
      <% } %>

      <dl class="summary">
        <div><dt><%= t('booking.code') %></dt><dd><span class="code"><%= booking.code %></span></dd></div>
        <div><dt><%= t('booking.name') %></dt><dd><%= booking.customer_name %></dd></div>
        <div><dt><%= t('booking.service') %></dt><dd><%= booking.service_name %></dd></div>
        <div><dt><%= t('booking.when') %></dt><dd><strong><%= formatDate(booking.date) %>, <%= fromMin(booking.start_min) %></strong></dd></div>
        <div><dt><%= t('booking.address') %></dt><dd><%= business.address %></dd></div>
        <% if (booking.paid_amount > 0) { %>
          <div><dt><%= t('booking.paid') %></dt><dd><%= formatPrice(booking.paid_amount) %></dd></div>
        <% } %>
        <% if (status === 'confirmed' && booking.price > booking.paid_amount) { %>
          <div><dt><%= t('booking.balance') %></dt><dd><%= formatPrice(booking.price - booking.paid_amount) %></dd></div>
        <% } %>
      </dl>

      <% if (status === 'confirmed') { %>
        <p class="hint"><%= t('booking.arrive_note') %></p>
        <div class="actions">
          <a class="btn btn-secondary" href="/booking/<%= booking.token %>/calendar.ics"><%= t('booking.add_calendar') %></a>
          <% if (business.map_url) { %><a class="btn btn-ghost" href="<%= business.map_url %>" target="_blank" rel="noopener"><%= t('contact.map') %></a><% } %>
        </div>
      <% } else if (status === 'pending') { %>
        <p><a class="btn btn-primary btn-block" href="/pay/<%= booking.token %>"><%= t('booking.go_pay') %></a></p>
      <% } else { %>
        <% if (booking.refund_status === 'pending') { %><p class="alert alert-info"><%= t('booking.refund_note') %></p><% } %>
        <p><a class="btn btn-primary" href="/book?service=<%= booking.service_id %>"><%= t('pay.retry') %></a></p>
      <% } %>

      <p class="hint"><%= t('booking.contact_us', { phone: business.phone }) %> <a href="<%= telHref %>"><%= t('contact.call') %></a></p>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
