<%- include('partials/head') %>
<%- include('partials/header') %>

<section class="section section-tight">
  <div class="container narrow">
  <% if (status === 'pending' && payment) { %>
    <div class="pay" id="pay"
         data-token="<%= booking.token %>"
         data-expires="<%= booking.hold_expires_at %>"
         data-server-now="<%= serverNow %>"
         data-msg-checking="<%= t('pay.checking') %>"
         data-msg-not-yet="<%= t('pay.not_yet') %>"
         data-msg-check="<%= t('pay.check') %>">
      <h1><%= title %></h1>

      <div class="pay-head">
        <div>
          <p class="pay-label"><%= t('pay.amount') %></p>
          <p class="pay-amount"><%= formatPrice(payment.amount) %></p>
        </div>
        <div class="pay-timer">
          <p class="pay-label"><%= t('pay.time_left') %></p>
          <p class="pay-countdown" id="countdown">--:--</p>
        </div>
      </div>
      <p class="pay-booking">
        <%= booking.service_name %> · <%= formatDate(booking.date) %> <%= fromMin(booking.start_min) %>
        · <span class="code"><%= booking.code %></span>
      </p>

      <% if (qpayMock) { %>
        <div class="alert alert-info">
          <p><%= t('pay.mock_note') %></p>
          <form method="post" action="/mock/pay/<%= booking.token %>">
            <button class="btn btn-primary btn-sm" type="submit"><%= t('pay.mock_pay') %></button>
          </form>
        </div>
      <% } %>

      <% if (deeplinks.length) { %>
        <div class="banks">
          <h2 class="h3"><%= t('pay.open_bank') %></h2>
          <div class="bank-grid">
            <% deeplinks.forEach((d) => { %>
              <a class="bank" href="<%= d.link %>">
                <% if (d.logo) { %><img src="<%= d.logo %>" alt="" width="40" height="40"><% } %>
                <span><%= d.description || d.name %></span>
              </a>
            <% }) %>
          </div>
        </div>
      <% } %>

      <div class="qr-block">
        <p class="muted"><%= t('pay.scan') %></p>
        <% if (payment.qr_image) { %>
          <img class="qr" src="data:image/png;base64,<%= payment.qr_image %>" width="240" height="240" alt="QPay QR">
        <% } else { %>
          <div class="qr qr-placeholder" aria-hidden="true">QR</div>
        <% } %>
        <% if (payment.short_url) { %>
          <p><a class="btn btn-ghost btn-sm" href="<%= payment.short_url %>" rel="noopener"><%= t('pay.short_url') %></a></p>
        <% } %>
      </div>

      <p class="pay-status" id="pay-status" aria-live="polite"><span class="spinner" aria-hidden="true"></span><%= t('pay.waiting') %></p>
      <button class="btn btn-secondary btn-block" type="button" id="check-btn"><%= t('pay.check') %></button>
      <p class="hint center"><a href="/policy" target="_blank"><%= t('nav.policy') %></a></p>
    </div>
  <% } %>

    <div class="result-card status-expired" id="pay-expired"<% if (status === 'pending' && payment) { %> hidden<% } %>>
      <div class="result-icon" aria-hidden="true">!</div>
      <h1><%= status === 'cancelled' ? t('booking.title_cancelled') : t('pay.expired_title') %></h1>
      <p class="muted"><%= status === 'pending' && !payment ? t('pay.no_invoice') : t('pay.expired_text') %></p>
      <p><a class="btn btn-primary" href="/book?service=<%= booking.service_id %>"><%= t('pay.retry') %></a></p>
    </div>
  </div>
</section>

<%- include('partials/footer', { scripts: ['/assets/js/pay.js'] }) %>
