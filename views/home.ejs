<%- include('partials/head') %>
<%- include('partials/header') %>
<%
  const telHref = 'tel:' + business.phone.replace(/[^\d+]/g, '');
  const heroImg = siteImage('hero');
  const introImg = siteImage('intro');
  const prepareImg = siteImage('prepare');
  const ctaImg = siteImage('cta');
  const bookHref = (time) => `/book?service=${nextSlot.service.id}&date=${nextSlot.date}&time=${time}`;
%>

<section class="hero hero-photo">
  <img class="hero-img" src="<%= asset(heroImg.small || heroImg.src) %>"<% if (srcset(heroImg)) { %> srcset="<%= srcset(heroImg) %>" sizes="100vw"<% } %>
       width="<%= heroImg.width %>" height="<%= heroImg.height %>" alt="" fetchpriority="high">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow"><%= t('home.eyebrow') %></p>
      <h1><%= business.name %></h1>
      <p class="lead"><%= business.tagline %></p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-lg" href="/book"><%= t('home.hero_btn_primary') %></a>
        <a class="btn btn-light btn-lg" href="#services"><%= t('home.hero_btn_secondary') %></a>
      </div>
      <ul class="trust">
        <li><%= t('home.trust_online') %></li>
        <li><%= t('home.trust_qpay') %></li>
        <li><%= t('home.trust_sms') %></li>
      </ul>
    </div>

    <aside class="slot-card" aria-label="<%= t('home.next_free') %>">
      <p class="slot-card-head"><span class="live-dot" aria-hidden="true"></span><%= t('home.next_free') %></p>
      <% if (nextSlot) { %>
        <div class="slot-card-main">
          <div class="slot-date" aria-hidden="true">
            <span class="slot-date-month"><%= nextSlot.parts.month %></span>
            <span class="slot-date-day"><%= nextSlot.parts.day %></span>
            <span class="slot-date-wd"><%= nextSlot.parts.weekdayShort %></span>
          </div>
          <div class="slot-time">
            <span class="slot-when"><%= nextSlot.when ? t(`home.${nextSlot.when}`) : nextSlot.parts.weekday %></span>
            <strong><%= nextSlot.time %></strong>
            <span class="slot-service"><%= nextSlot.service.name %> · <%= t('services.duration', { n: nextSlot.service.duration_min }) %></span>
          </div>
        </div>
        <% if (nextSlot.more.length) { %>
        <div class="slot-more">
          <p class="slot-more-label"><%= t('home.next_more') %></p>
          <div class="slot-chips">
            <% nextSlot.more.forEach((time) => { %><a class="slot-chip" href="<%= bookHref(time) %>"><%= time %></a><% }) %>
          </div>
        </div>
        <% } %>
        <a class="btn btn-primary btn-block btn-lg slot-cta" href="<%= bookHref(nextSlot.time) %>">
          <%= t('home.next_take') %>
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <p class="slot-foot">
          <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 10V8a6 6 0 1112 0v2m-13 0h14v11H5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
          <%= formatPrice(nextSlot.service.price) %> · <%= t('home.trust_qpay') %>
        </p>
      <% } else { %>
        <p class="slot-empty"><%= t('home.next_none') %></p>
        <a class="btn btn-primary btn-block btn-lg" href="/book"><%= t('home.hero_btn_primary') %></a>
      <% } %>
    </aside>
  </div>
</section>

<section class="section">
  <div class="container intro">
    <figure class="intro-media">
      <img src="<%= asset(introImg.small || introImg.src) %>"<% if (srcset(introImg)) { %> srcset="<%= srcset(introImg) %>" sizes="(min-width: 900px) 440px, 100vw"<% } %>
           width="<%= introImg.width %>" height="<%= introImg.height %>" loading="lazy" decoding="async" alt="">
    </figure>
    <div class="intro-copy">
      <p class="eyebrow eyebrow-soft"><%= t('home.intro_eyebrow') %></p>
      <h2><%= content.home_title_mn %></h2>
      <div class="prose"><%- paragraphs(content.home_intro_mn) %></div>
      <% if (highlights.length) { %>
      <ul class="highlights">
        <% highlights.forEach((h) => { %>
          <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="currentColor" opacity=".12"/><path d="M7 12.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><%= h %></li>
        <% }) %>
      </ul>
      <% } %>
      <a href="/about"><%= t('home.intro_link') %> →</a>
    </div>
  </div>
</section>

<% if (services.length) { %>
<section class="section section-soft" id="services">
  <div class="container">
    <div class="section-head">
      <div>
        <h2><%= t('home.services_title') %></h2>
        <p class="section-sub"><%= t('home.services_sub') %></p>
      </div>
      <a href="/services"><%= t('home.all_services') %> →</a>
    </div>
    <div class="cards">
      <% services.forEach((s) => { %><%- include('partials/service-card', { s }) %><% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section">
  <div class="container">
    <h2><%= t('home.how_title') %></h2>
    <ol class="how">
      <li><span class="how-num">1</span><%= t('home.step1') %></li>
      <li><span class="how-num">2</span><%= t('home.step2') %></li>
      <li><span class="how-num">3</span><%= t('home.step3') %></li>
    </ol>
  </div>
</section>

<% if (prepare.length) { %>
<section class="section section-soft">
  <div class="container split">
    <div>
      <h2><%= t('home.prepare_title') %></h2>
      <p class="section-sub"><%= t('home.prepare_sub') %></p>
      <ol class="checklist">
        <% prepare.forEach((item) => { %><li><%= item %></li><% }) %>
      </ol>
    </div>
    <figure class="split-media">
      <img src="<%= asset(prepareImg.small || prepareImg.src) %>"<% if (srcset(prepareImg)) { %> srcset="<%= srcset(prepareImg) %>" sizes="(min-width: 720px) 50vw, 100vw"<% } %>
           width="<%= prepareImg.width %>" height="<%= prepareImg.height %>" loading="lazy" decoding="async" alt="">
    </figure>
  </div>
</section>
<% } %>

<% if (gallery.length) { %>
<section class="section">
  <div class="container">
    <h2><%= t('home.gallery_title') %></h2>
    <div class="gallery">
      <% gallery.forEach((g, i) => { const caption = g.caption_mn; %>
        <figure>
          <img src="<%= asset(g.small || g.src) %>"<% if (srcset(g)) { %> srcset="<%= srcset(g) %>" sizes="<%= i === 0 ? '(min-width: 720px) 50vw, 100vw' : '(min-width: 720px) 25vw, 50vw' %>"<% } %>
               width="<%= g.width %>" height="<%= g.height %>" loading="lazy" decoding="async" alt="<%= caption || '' %>">
          <% if (caption) { %><figcaption><%= caption %></figcaption><% } %>
        </figure>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (faq.length) { %>
<section class="section section-soft">
  <div class="container">
    <h2><%= t('home.faq_title') %></h2>
    <div class="faq">
      <% faq.forEach((item, i) => { %>
        <details<% if (i === 0) { %> open<% } %>>
          <summary><%= item.q %></summary>
          <%- paragraphs(item.a) %>
        </details>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section">
  <div class="container two-col">
    <div>
      <h2><%= t('home.contact_title') %></h2>
      <div class="contact-list">
        <div class="contact-item">
          <p class="contact-label"><%= t('contact.address') %></p>
          <p><%= business.address %></p>
          <% if (business.map_url) { %><a class="btn btn-ghost btn-sm" href="<%= business.map_url %>" target="_blank" rel="noopener"><%= t('contact.map') %></a><% } %>
        </div>
        <div class="contact-item">
          <p class="contact-label"><%= t('contact.phone') %></p>
          <p><a class="phone-link" href="<%= telHref %>"><%= business.phone %></a></p>
        </div>
      </div>
    </div>
    <div class="info-card">
      <h2 class="h3"><%= t('home.hours_title') %></h2>
      <%- include('partials/hours') %>
    </div>
  </div>
</section>

<section class="cta-band">
  <img class="cta-img" src="<%= asset(ctaImg.small || ctaImg.src) %>"<% if (srcset(ctaImg)) { %> srcset="<%= srcset(ctaImg) %>" sizes="100vw"<% } %>
       width="<%= ctaImg.width %>" height="<%= ctaImg.height %>" loading="lazy" decoding="async" alt="">
  <div class="container">
    <h2><%= t('home.cta_title') %></h2>
    <p><%= t('home.cta_text') %></p>
    <a class="btn btn-primary btn-lg" href="/book"><%= t('home.cta_btn') %></a>
  </div>
</section>

<%- include('partials/footer') %>
