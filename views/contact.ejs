<%- include('partials/head') %>
<%- include('partials/header') %>

<section class="section page-head">
  <div class="container">
    <h1><%= title %></h1>
  </div>
</section>

<section class="section section-tight">
  <div class="container two-col">
    <div class="contact-list">
      <div class="contact-item">
        <p class="contact-label"><%= t('contact.phone') %></p>
        <p><a class="phone-link" href="tel:<%= business.phone.replace(/[^\d+]/g, '') %>"><%= business.phone %></a></p>
        <a class="btn btn-primary btn-sm" href="tel:<%= business.phone.replace(/[^\d+]/g, '') %>"><%= t('contact.call') %></a>
      </div>
      <div class="contact-item">
        <p class="contact-label"><%= t('contact.address') %></p>
        <p><%= business.address %></p>
        <% if (business.map_url) { %>
          <a class="btn btn-ghost btn-sm" href="<%= business.map_url %>" target="_blank" rel="noopener"><%= t('contact.map') %></a>
        <% } %>
      </div>
      <% if (business.email) { %>
      <div class="contact-item">
        <p class="contact-label"><%= t('contact.email') %></p>
        <p><a href="mailto:<%= business.email %>"><%= business.email %></a></p>
      </div>
      <% } %>
      <% if (business.facebook_url) { %>
      <div class="contact-item">
        <p class="contact-label">Facebook</p>
        <p><a href="<%= business.facebook_url %>" target="_blank" rel="noopener"><%= t('contact.facebook') %></a></p>
      </div>
      <% } %>
    </div>
    <div class="info-card">
      <h2 class="h3"><%= t('home.hours_title') %></h2>
      <%- include('partials/hours') %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
