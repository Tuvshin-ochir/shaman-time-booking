<%- include('partials/head') %>
<%- include('partials/header') %>

<section class="section section-tight">
  <div class="container narrow">
    <h1><%= title %></h1>

    <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
    <noscript><div class="alert alert-error"><%= t('book.noscript') %></div></noscript>

    <% if (!services.length) { %>
      <p class="muted"><%= t('services.empty') %></p>
    <% } else { %>
    <form class="book-form" id="book-form" method="post" action="/book" novalidate>
      <fieldset class="step" id="step-service">
        <legend><span class="step-num">1</span><%= t('book.step_service') %></legend>
        <div class="options">
          <% services.forEach((s) => { %>
          <label class="option">
            <input type="radio" name="service_id" value="<%= s.id %>"<%= String(form.service_id) === String(s.id) ? ' checked' : '' %>>
            <span class="option-body">
              <span class="option-title"><%= s.name %></span>
              <span class="option-meta"><%= t('services.duration', { n: s.duration }) %></span>
              <span class="option-price"><%= formatPrice(s.price) %></span>
            </span>
          </label>
          <% }) %>
        </div>
      </fieldset>

      <fieldset class="step" id="step-time" hidden>
        <legend><span class="step-num">2</span><%= t('book.step_time') %></legend>
        <div class="days" id="days" role="radiogroup" aria-label="<%= t('book.step_time') %>"></div>
        <p class="day-label" id="day-label" aria-live="polite"></p>
        <div class="times" id="times" role="radiogroup" aria-live="polite"></div>
        <input type="hidden" name="date" id="f-date" value="<%= form.date || '' %>">
        <input type="hidden" name="time" id="f-time" value="<%= form.time || '' %>">
      </fieldset>

      <fieldset class="step" id="step-contact" hidden>
        <legend><span class="step-num">3</span><%= t('book.step_contact') %></legend>
        <div class="field">
          <label for="f-name"><%= t('book.name') %></label>
          <input id="f-name" name="name" autocomplete="name" maxlength="80" placeholder="<%= t('book.name_ph') %>" value="<%= form.name || '' %>">
          <p class="field-error" id="name-error" hidden></p>
        </div>
        <div class="field">
          <label for="f-phone"><%= t('book.phone') %></label>
          <input id="f-phone" name="phone" type="tel" inputmode="numeric" autocomplete="tel" maxlength="16" placeholder="<%= t('book.phone_ph') %>" value="<%= form.phone || '' %>" aria-describedby="phone-hint">
          <p class="hint" id="phone-hint"><%= t('book.phone_hint') %></p>
          <p class="field-error" id="phone-error" hidden></p>
        </div>
        <div class="field">
          <label for="f-note"><%= t('book.note') %></label>
          <textarea id="f-note" name="note" rows="2" maxlength="500"><%= form.note || '' %></textarea>
        </div>
      </fieldset>

      <fieldset class="step" id="step-confirm" hidden>
        <legend><span class="step-num">4</span><%= t('book.step_confirm') %></legend>
        <dl class="summary">
          <div><dt><%= t('book.summary_service') %></dt><dd id="sum-service"></dd></div>
          <div><dt><%= t('book.summary_when') %></dt><dd id="sum-when"></dd></div>
          <div><dt><%= t('book.summary_price') %></dt><dd id="sum-price"></dd></div>
          <div class="summary-total"><dt><%= t('book.summary_pay_now') %></dt><dd id="sum-due"></dd></div>
        </dl>
        <p class="hint" id="sum-balance" hidden><%= t('book.summary_balance') %></p>
        <p class="hint"><%= t('book.hold_note', { minutes: holdMinutes }) %></p>
        <div class="check">
          <input type="checkbox" id="f-agree" name="agree" value="1">
          <label for="f-agree"><%= t('book.agree') %> · <a href="/policy" target="_blank"><%= t('book.read_policy') %></a></label>
        </div>
        <p class="field-error" id="form-error" role="alert" hidden></p>
        <button class="btn btn-primary btn-block btn-lg" type="submit" id="submit-btn"><%= t('book.submit') %></button>
      </fieldset>
    </form>
    <% } %>
  </div>
</section>

<script type="application/json" id="book-data"><%- bootstrap %></script>
<%- include('partials/footer', { scripts: ['/assets/js/book.js'] }) %>
