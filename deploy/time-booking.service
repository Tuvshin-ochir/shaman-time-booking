[Unit]
Description=Time booking (Next.js)
After=network.target

[Service]
Type=simple
User=booking
WorkingDirectory=/srv/time-booking/app
Environment=NODE_ENV=production
# Run `npm run build` first. Listens on localhost only; nginx is in front.
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3000 -H 127.0.0.1
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/srv/time-booking

[Install]
WantedBy=multi-user.target
